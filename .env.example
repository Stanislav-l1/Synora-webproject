# ============================================================
# Synora — Environment Variables
# Copy this file to .env and replace all placeholder values
# ============================================================

# ── Database ──
DB_NAME=synora
DB_USER=synora
DB_PASSWORD=CHANGE_ME_db_password

# ── Redis ──
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── MinIO (S3-compatible storage) ──
S3_ACCESS_KEY=CHANGE_ME_minio_access_key
S3_SECRET_KEY=CHANGE_ME_minio_secret_key
S3_BUCKET=synora-files
S3_REGION=us-east-1

# ── JWT (min 256-bit, base64-encoded) ──
# Generate with: openssl rand -base64 44
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_44

# ── Spring ──
SPRING_PROFILE=prod
LOG_LEVEL=INFO

# ── Ports (only nginx is exposed externally) ──
NGINX_PORT=80

# ── GitHub OAuth ──
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ── SMTP (email sending) ──
# Gmail: use App Password (https://myaccount.google.com/apppasswords)
# Resend: SMTP_HOST=smtp.resend.com SMTP_PORT=587 SMTP_USER=resend SMTP_PASSWORD=re_xxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password

# ── HTTPS (only needed with docker-compose.https.yml overlay) ──
# DOMAIN=synora.example.com
# LETSENCRYPT_EMAIL=admin@example.com
# LETSENCRYPT_STAGING=0   # set to 1 when testing to avoid rate limits

# ── Backups (only needed with docker-compose.backup.yml overlay) ──
# BACKUP_HOST_DIR=./backups       # where dumps land on the host
# BACKUP_CRON=0 3 * * *           # daily at 03:00 (container TZ)
# BACKUP_RETENTION_DAYS=14
# TZ=UTC
